#!/usr/bin/env bash
# Exercise the desktop backends against real tools in a Fedora container.
# Needs podman (or docker via CONTAINER=docker) and network access for the first build.
set -euo pipefail
cd "$(dirname "$0")/.."
engine=${CONTAINER:-podman}
"$engine" build -q -t artwall-desktops -f tests/desktops/Containerfile tests/desktops >/dev/null
# Fedora installs sway with cap_sys_nice, which it cannot exec without that capability.
# ARTWALL_SCREENSHOTS=DIR saves screenshots of the native app there.
screenshots=()
if [ -n "${ARTWALL_SCREENSHOTS:-}" ]; then
    mkdir -p "$ARTWALL_SCREENSHOTS"
    screenshots=(-v "$(cd "$ARTWALL_SCREENSHOTS" && pwd)":/screenshots -e ARTWALL_SCREENSHOTS=/screenshots)
fi
"$engine" run --rm --cap-add SYS_NICE --security-opt label=disable -v "$PWD":/src:ro "${screenshots[@]}" artwall-desktops
